# CITYMO ERP — Supabase project npddbwsskaojcawaxygh
VITE_SUPABASE_URL=https://npddbwsskaojcawaxygh.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-from-supabase-dashboard

# Optional — Express API (Railway)
# VITE_API_URL=http://localhost:3000/api
# Ne jamais mettre OCR_SERVICE_URL / OCR_SERVICE_API_KEY dans VITE_*

# OCR production — variables BACKEND uniquement (Vercel / Railway Express) :
# OCR_SERVICE_URL=https://votre-ocr.railway.app
# OCR_SERVICE_API_KEY=secret-partage-avec-ocr-service
# OCR_TIMEOUT_MS=90000
# ENABLE_BROWSER_OCR_FALLBACK=false
#
# Debug client uniquement : VITE_OCR_DEBUG=true
# Dev local Tesseract (JAMAIS en prod) : VITE_ENABLE_BROWSER_OCR_FALLBACK=true

# Pour sauvegardes (proxy Vercel → Railway) :
# RAILWAY_API_URL=https://votre-app.railway.app
#
# Pour mot de passe admin (fonction Vercel — OBLIGATOIRE en prod) :
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# SUPABASE_URL / SUPABASE_ANON_KEY (réutiliser VITE_* sur Vercel)

# ─── Edge Function notify-leave-request (secrets Supabase uniquement) ───
# Guide complet : supabase/functions/notify-leave-request/README.md
#
# supabase secrets set RESEND_API_KEY=re_xxx LEAVE_NOTIFY_TO=selim.moumni@citymo.ma
# supabase functions deploy notify-leave-request
#
# RESEND_API_KEY     — clé API Resend (obligatoire pour envoi réel)
# LEAVE_NOTIFY_TO    — selim.moumni@citymo.ma
# LEAVE_NOTIFY_FROM  — ex. CITYMO Congés <conges@citymo.ma> ou onboarding@resend.dev (test)
# LEAVE_APP_URL      — URL app pour lien CTA dans l'email (optionnel)

# ─── Web Push VAPID (serveur UNIQUEMENT — Vercel / Railway, jamais VITE_*) ───
# Générer : node scripts/generate-vapid-keys.mjs
# Puis coller dans Vercel → Settings → Environment Variables (Production + Preview)
# et éventuellement Railway si l'envoi push y est hébergé plus tard.
#
# VAPID_PUBLIC_KEY=...   # exposée via GET /api/push/vapid-public-key (session requise)
# VAPID_PRIVATE_KEY=...  # SECRET serveur — jamais dans le frontend / jamais committer
# VAPID_SUBJECT=mailto:noreply@citymoapp.com
#
# Ne PAS créer VITE_VAPID_PRIVATE_KEY ni VITE_VAPID_PUBLIC_KEY.
