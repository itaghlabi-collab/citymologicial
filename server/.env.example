# CITYMO ERP — Backend Express (port 3000)
PORT=3000

# ── Railway (obligatoire pour sauvegardes + auth Super Admin) ───────────────
# SUPABASE_URL est optionnel si le projet CITYMO par défaut est utilisé.
# Copier depuis Vercel → Settings → Environment Variables :
SUPABASE_URL=https://npddbwsskaojcawaxygh.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Origines CORS supplémentaires (séparées par des virgules) :
# ALLOWED_ORIGINS=https://preview.example.com

# ── Supabase (sauvegardes ERP — service_role jamais côté client) ─────────────
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Provider : supabase_storage | local
BACKUP_STORAGE_PROVIDER=supabase_storage
BACKUP_LOCAL_DIR=./data/backups

# Fichiers Storage : full (copie physique complète, défaut sauvegarde complète) | manifest (inventaire seul)
BACKUP_FILES_MODE=full
# BACKUP_FILES_MODE=manifest
# BACKUP_FILE_COPY_CONCURRENCY=4
# BACKUP_FILE_COPY_TIMEOUT_MS=120000
# BACKUP_FILE_COPY_RETRIES=3
# BACKUP_MAX_FILE_BYTES=104857600
# BACKUP_DRIVE_UPLOAD_TIMEOUT_MS=300000
# BACKUP_UPLOAD_TIMEOUT_MS=600000
# BACKUP_PROGRESS_STALE_MS=600000
# BACKUP_HEARTBEAT_STALE_MS=600000
# BACKUP_STUCK_AFTER_MS=900000
# BACKUP_DB_HEARTBEAT_MS=30000

# ── Google Drive (2e copie) — projet citymo-erp-sauvegardes ───────────────────
# Deux modes (détection auto si BACKUP_GOOGLE_DRIVE_AUTH_MODE=auto) :
#
# MODE 1 (préféré) — OAuth utilisateur → Mon Drive personnel
#   GOOGLE_OAUTH_CLIENT_ID / SECRET / REFRESH_TOKEN
#   GOOGLE_DRIVE_FOLDER_ID = dossier dans votre Mon Drive
#
# MODE 2 — Service Account → Drive partagé (Shared Drive) UNIQUEMENT
#   GOOGLE_SERVICE_ACCOUNT_JSON
#   Dossier dans un Shared Drive (pas Mon Drive) — sinon « storage quota »
#
# auto = OAuth si configuré, sinon Service Account
BACKUP_GOOGLE_DRIVE_AUTH_MODE=auto
BACKUP_GOOGLE_DRIVE_ENABLED=true
# true (défaut) = échec global si Drive vide | false = succès partiel avec Drive ⚠
BACKUP_GOOGLE_DRIVE_REQUIRED=true
GOOGLE_DRIVE_FOLDER_ID=REMPLACER_PAR_ID_DOSSIER_DRIVE
# Optionnel — ID du drive partagé (URL .../drives/XXXX) si détection auto échoue (mode SA)
# GOOGLE_DRIVE_SHARED_DRIVE_ID=
# MODE 1 — OAuth (Mon Drive) — obtenir refresh token une fois via flow OAuth GCP
# Scope requis : https://www.googleapis.com/auth/drive (PAS drive.file seul)
# OAuth Playground Step 1 → Drive API v3 → cocher « …/auth/drive »
# GOOGLE_DRIVE_FOLDER_NAME= citymo-erp-sauvegardes (créé auto si scope drive.file)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=
# Callback OAuth reconnexion (Railway public URL + path)
# BACKUP_OAUTH_REDIRECT_URI=https://VOTRE-API.railway.app/api/backups/drive/oauth/callback
# Heure locale Africa/Algiers pour les planifications (défaut 03:15)
# BACKUP_SCHEDULE_HOUR=3
# BACKUP_SCHEDULE_MINUTE=15
# BACKUP_SCHEDULE_MAX_RETRIES=3
# MODE 2 — Service Account (Shared Drive)
# Fichier JSON téléchargé depuis GCP → Identifiants → Compte de service → Clés
# Coller le JSON COMPLET sur une seule ligne (pas seulement l'ID de clé)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"citymo-erp-sauvegardes",...}

# ── OCR CIN — service Python indépendant ─────────────────────────────────────
# ocr-service/ (PaddleOCR 3.x : fr_PP-OCRv5 + arabic_PP-OCRv5)
OCR_SERVICE_URL=http://127.0.0.1:8000
OCR_TIMEOUT_MS=90000
# Express = proxy uniquement. Ne pas embarquer Paddle ici.

# ─── Web Push VAPID (serveur uniquement — jamais exposé au frontend) ─────────
# Générer depuis la racine du monorepo : node scripts/generate-vapid-keys.mjs
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:noreply@citymoapp.com
